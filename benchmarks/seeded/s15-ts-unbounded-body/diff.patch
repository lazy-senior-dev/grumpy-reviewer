Ticket: HOOK-7 "Accept GitHub webhooks and verify the HMAC signature"

diff --git a/src/http/webhooks/github.ts b/src/http/webhooks/github.ts
--- /dev/null
+++ b/src/http/webhooks/github.ts
@@ -0,0 +1,31 @@
+import type { IncomingMessage, ServerResponse } from "node:http";
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { enqueue } from "../../queue";
+
+const SECRET = process.env.GITHUB_WEBHOOK_SECRET ?? "";
+
+export async function handleGithubWebhook(req: IncomingMessage, res: ServerResponse) {
+  if (!SECRET) {
+    res.writeHead(503).end("webhook secret not configured");
+    return;
+  }
+  const chunks: Buffer[] = [];
+  for await (const chunk of req) chunks.push(chunk as Buffer);
+  const raw = Buffer.concat(chunks);
+
+  const signature = String(req.headers["x-hub-signature-256"] ?? "");
+  const expected = "sha256=" + createHmac("sha256", SECRET).update(raw).digest("hex");
+  if (signature.length !== expected.length || !timingSafeEqual(Buffer.from(signature), Buffer.from(expected))) {
+    res.writeHead(401).end("bad signature");
+    return;
+  }
+
+  const event = String(req.headers["x-github-event"] ?? "unknown");
+  await enqueue("github-webhook", { event, payload: JSON.parse(raw.toString("utf8")) });
+  res.writeHead(202).end();
+}
+
+export function isSupportedEvent(event: string): boolean {
+  return ["push", "pull_request", "issues"].includes(event);
+}
