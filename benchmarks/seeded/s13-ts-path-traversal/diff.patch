Ticket: ATT-31 "Serve ticket attachments by file name"

diff --git a/src/http/attachments.ts b/src/http/attachments.ts
--- /dev/null
+++ b/src/http/attachments.ts
@@ -0,0 +1,25 @@
+import type { Request, Response } from "express";
+import { createReadStream, promises as fs } from "node:fs";
+import path from "node:path";
+import { requireTicketAccess } from "../auth/tickets";
+
+const ROOT = process.env.ATTACHMENTS_ROOT ?? "/srv/attachments";
+
+export async function download(req: Request, res: Response) {
+  const ticketId = String(req.params.ticketId);
+  await requireTicketAccess(req, ticketId);
+
+  const name = String(req.query.file ?? "");
+  const target = path.join(ROOT, ticketId, name);
+  try {
+    const stat = await fs.stat(target);
+    res.setHeader("Content-Length", String(stat.size));
+    res.setHeader("Content-Disposition", `attachment; filename="${path.basename(target)}"`);
+    createReadStream(target).pipe(res);
+  } catch (err: any) {
+    if (err?.code === "ENOENT") {
+      res.status(404).json({ error: "no such attachment" });
+      return;
+    }
+    throw err;
+  }
+}
