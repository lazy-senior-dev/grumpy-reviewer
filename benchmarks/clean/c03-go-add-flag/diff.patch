Ticket: CLI-17 "Add --shutdown-timeout so operators can tune graceful shutdown"

diff --git a/cmd/api/main.go b/cmd/api/main.go
--- a/cmd/api/main.go
+++ b/cmd/api/main.go
@@ -12,16 +12,24 @@ import (
 
 func main() {
 	addr := flag.String("addr", ":8080", "listen address")
+	shutdownTimeout := flag.Duration("shutdown-timeout", 15*time.Second, "how long to wait for in-flight requests on SIGTERM")
 	flag.Parse()
+	if *shutdownTimeout <= 0 {
+		fmt.Fprintln(os.Stderr, "--shutdown-timeout must be positive")
