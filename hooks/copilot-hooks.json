{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node hooks/grumpy-context.mjs --host copilot 2>/dev/null || true",
        "powershell": "node hooks/grumpy-context.mjs --host copilot",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node hooks/grumpy-gate.mjs --host copilot 2>/dev/null || true",
        "powershell": "node hooks/grumpy-gate.mjs --host copilot",
        "timeoutSec": 15
      }
    ]
  }
}
